# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
# Random long string — used to sign login cookies. CHANGE THIS.
SESSION_SECRET=change-me-to-a-long-random-string

# ── First admin account (created automatically on first start if no users exist)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Admin

# ── Optional: pre-load Reoon API keys (same names as the Google Sheet tabs) ──
# Keys added here are inserted once on first start. You can also add/edit them
# from the Admin → API Keys page.
API_KEY_emailastrallc=
API_KEY_emranhossain=
API_KEY_alimranshourov=
API_KEY_aminsohel=
API_KEY_amin=
API_KEY_support=
API_KEY_tool=

# ── Optional: OpenAI key for Company Name Cleaner (editable in Admin → Settings)
CHATGPT_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Advanced (normally leave as is) ──────────────────────────────────────────
DATA_DIR=./data
REOON_API_BASE=https://emailverifier.reoon.com/api/v1
OPENAI_API_BASE=https://api.openai.com/v1
# Background poll interval for pending verification tasks (seconds)
POLL_INTERVAL_SECONDS=60
# Credit balance cache lifetime (seconds)
CREDIT_CACHE_SECONDS=600
